rules_version = '2';

// =========================================================================
// CRM FIRESTORE SECURITY RULES — FINAL
// -------------------------------------------------------------------------
// This is your original rules file, unchanged, PLUS the three collections
// that were missing (`tasks`, `stats`, `stats_users`). Firestore denies
// everything by default for a collection with no matching rule — that gap
// is exactly why Dashboard counters and My Tasks showed nothing. Nothing
// else was changed from your original file.
//
// Deploy this from: Firebase Console > Firestore Database > Rules
// (paste this whole file in and click "Publish"), OR via Firebase CLI:
//   firebase deploy --only firestore:rules
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(myUid())).data.role;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(myUid())) &&
        myRole() == "Admin";
    }

    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------------- users ----------------
    match /users/{uid} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
                      isAdmin()
                      ||
                      ( myUid() == uid && request.resource.data.role == "User" )
                    );

      // Same as your original, plus one narrow addition (last line): any
      // signed-in user may bump ONLY the `unreadCount` badge field on
      // someone else's profile — needed because a normal user's action
      // (e.g. finishing a task) notifies the Admin, which has to update
      // the Admin's own badge count. No other field can move this way.
      allow update: if isSignedIn() && (
                      isAdmin()
                      ||
                      (
                        myUid() == uid &&
                        request.resource.data.role == resource.data.role &&
                        (!("adminApprovalPending" in resource.data) || request.resource.data.adminApprovalPending == resource.data.adminApprovalPending) &&
                        (!("disabled" in resource.data) || request.resource.data.disabled == resource.data.disabled)
                      )
                      ||
                      onlyChanges(['unreadCount'])
                    );

      allow delete: if isAdmin();
    }

    // ---------------- crmprojects ----------------
    match /crmprojects/{id} {

      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == myUid();

      allow update: if isSignedIn() && (
                       isAdmin() ||
                       resource.data.ownerUid == myUid()
                     );

      allow delete: if isSignedIn() && isAdmin();
    }

    // ---------------- notifications ----------------
    match /notifications/{id} {

      allow read: if isSignedIn() && (isAdmin() || resource.data.targetUid == myUid());

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (isAdmin() || resource.data.targetUid == myUid());

      allow delete: if isAdmin();
    }

    // ---------------- tasks (NEW — this was completely missing) ----------------
    // Only an Admin can create/assign a task. The person it's assigned to
    // can read their own tasks and update the `status` field (Pending / In
    // Progress / Complete) to reflect progress.
    match /tasks/{id} {

      allow read: if isSignedIn() && (isAdmin() || resource.data.assignedToUid == myUid());

      allow create: if isSignedIn() && isAdmin();

      allow update: if isSignedIn() && (
                      isAdmin() || resource.data.assignedToUid == myUid()
                    );

      allow delete: if isAdmin();
    }

    // ---------------- activityLogs ----------------
    match /activityLogs/{id} {

      allow read: if isAdmin();

      allow create: if isSignedIn();

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ---------------- stats (NEW — this was completely missing) ----------------
    // Dashboard/Analytics read ONE small doc instead of scanning the whole
    // crmprojects collection. Any signed-in user can update it (their own
    // project create/edit/delete needs to bump the shared counters).
    match /stats/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /stats_users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---------------- teams (reserved for future use) ----------------
    match /teams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
